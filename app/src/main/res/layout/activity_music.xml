<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2E1B10"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Music Settings"
        android:textColor="#F5F5DC"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnPickSong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#A68966"
        android:text="Select Song From Device"
        android:textColor="#2E1B10"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/tvSongName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No song selected"
        android:textColor="#A68966"
        android:textSize="16sp"
        android:layout_marginBottom="30dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp">

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            app:srcCompat="@android:drawable/ic_media_play"
            app:tint="#F5F5DC" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Volume Control"
        android:textColor="#F5F5DC"
        android:layout_gravity="left"
        android:layout_marginBottom="8dp"/>

    <SeekBar
        android:id="@+id/volumeSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progressTint="#FFD700"
        android:thumbTint="#FFD700"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#4E342E"
        android:text="Back to Menu"
        android:textColor="#F5F5DC"
        android:paddingStart="30dp"
        android:paddingEnd="30dp" />

</LinearLayout>