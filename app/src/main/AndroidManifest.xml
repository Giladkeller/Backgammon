<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.spotify.music" />
    </queries>


    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BackGammonFinal">
        <service
            android:name=".Music.MusicService"
            android:foregroundServiceType="mediaPlayback"
            android:enabled="true"
            android:exported="false" />
        <activity
            android:name=".Music.MusicActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>
        <activity
            android:name=".StartActivities.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Users.users"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Game.GameActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".StartActivities.OpenActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>